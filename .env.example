# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenCode / local OpenAI-compatible endpoint
# OPENCODE_BASE_URL=http://localhost:8080/v1
# OPENCODE_API_KEY=dummy
# OPENCODE_MODEL=default

# Provider selection: openrouter | opencode
LLM_PROVIDER=openrouter

# Simulation
TOTAL_TICKS=100
ACTION_PROBABILITY=0.7 # the probability that an agent will take an action on a given tick
BELIEF_UPDATE_INTERVAL=5 # how often (in ticks) agents update their beliefs based on observations

# Logging
LOG_LEVEL=INFO
LOG_EVENTS=true
LOG_PATH=logs
